{
  "name": "langu-account-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 1430",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:attached": "tauri dev --config src-tauri/tauri.dev.conf.json --config src-tauri/tauri.preview.conf.json",
    "tauri:build": "node scripts/desktop.mjs build auto",
    "tauri:build:mac": "node scripts/desktop.mjs build mac",
    "tauri:build:mac:arm": "node scripts/desktop.mjs build mac arm64",
    "tauri:build:mac:intel": "node scripts/desktop.mjs build mac x64",
    "tauri:build:mac:universal": "node scripts/desktop.mjs build mac universal",
    "tauri:build:win": "node scripts/desktop.mjs build win x64",
    "tauri:build:win:x86": "node scripts/desktop.mjs build win ia32",
    "tauri:build:win:arm": "node scripts/desktop.mjs build win arm64",
    "tauri:build:linux": "node scripts/desktop.mjs build linux",
    "tauri:build:linux:x64": "node scripts/desktop.mjs build linux x64",
    "tauri:build:linux:arm": "node scripts/desktop.mjs build linux arm64",
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:system": "node scripts/test-system.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^18.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "latest",
    "typescript-eslint": "^8.71.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "latest"
  }
}
